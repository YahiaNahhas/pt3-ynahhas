<h1>Book List</h1>

<table class="table table-hover">
  <thead class="table-dark">
    <tr>
      <th>Title</th>
      <th>Author</th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @books.each do |book| %>
      <tr>
        <td><%= book.title %></td>
        <td><%= book.author %></td>
        <td><%= link_to "Show", book_path(book), class: "btn btn-primary" %></td>
      </tr>
    <% end %>
  </tbody>
</table>
